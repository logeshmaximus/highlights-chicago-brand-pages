# Vercel environment variables for the Highlights Chicago brand service pages app.
# In Vercel: Project → Settings → Environment Variables → "Import .env" (or paste this file),
# tick Production, Preview and Development. Never commit the filled-in copy (.env.local).

# --- Sanity: where the brand pages live (the "Brand Service Pages" studio) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=x6yq02oi
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Viewer token, so the preview can show drafts. Create it at:
# sanity.io/manage → project x6yq02oi → API → Tokens → Add API token → Permissions: Viewer
SANITY_API_READ_TOKEN=paste-viewer-token-here

# --- Links between the site and the Studio ---
# The deployed Studio (opens drafts from the preview's "Edit" links).
NEXT_PUBLIC_SANITY_STUDIO_URL=https://hc-brand-service-pages.sanity.studio
# This site's own address. Use the Vercel URL until a domain is attached.
NEXT_PUBLIC_SITE_URL=https://brand-service-page.vercel.app

# Any long random string. The same value goes in the Sanity webhook, so a page
# updates on the site as soon as it is published.
SANITY_REVALIDATE_SECRET=paste-a-long-random-string-here
